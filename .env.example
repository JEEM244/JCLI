# Copia este archivo como .env y agrega tus claves personales.
# No subas .env a GitHub ni compartas estas claves.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Activa la generación solo después de revisar los costos y tener autorización.
# Mientras esté en false, troc ai ask no enviará solicitudes de generación.
JCLI_ENABLE_API_CALLS=false

# Modelos iniciales moderados; puedes cambiarlos según los modelos disponibles en tu cuenta.
OPENAI_MODEL=gpt-5.4-mini
GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_MODEL=deepseek-flash
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_VERSION=2026-10-21

# Límites locales (UTC). No sustituyen los límites de gasto del proveedor.
JCLI_MAX_REQUESTS_PER_DAY=5
JCLI_MAX_INPUT_CHARS=6000
JCLI_MAX_OUTPUT_TOKENS=512
JCLI_REQUEST_TIMEOUT_MS=90000

# Coordinación multiagente: requiere también JCLI_ENABLE_API_CALLS=true.
# Mantener apagado evita llamadas secuenciales a varios proveedores.
JCLI_ENABLE_TEAM_RUNS=false

# Copia este archivo como .env y agrega tus claves personales.
# No subas .env a GitHub ni compartas estas claves.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Modelos predeterminados (puedes cambiarlos según el acceso de tu cuenta).
OPENAI_MODEL=gpt-6.2-astra
GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_MODEL=deepseek-flash
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_VERSION=2026-10-21

# Límites locales (UTC). Estos topes no sustituyen los límites de gasto del proveedor.
JCLI_MAX_REQUESTS_PER_DAY=20
JCLI_MAX_INPUT_CHARS=12000
JCLI_MAX_OUTPUT_TOKENS=1024
JCLI_REQUEST_TIMEOUT_MS=90000
